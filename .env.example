# Copy this file to .env for local Docker Compose use.
# Replace the example value with a long random secret before sharing/deploying.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_PRODUCTION=false
DATABASE_URL=sqlite:////app/instance/passkey_demo.db
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
TRUST_PROXY_HEADERS=false
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Secure Passkey Auth
WEBAUTHN_ORIGIN=
CSRF_PROTECT=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONTENT_LENGTH=1048576
PERMANENT_SESSION_LIFETIME=3600
